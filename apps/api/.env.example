# ---------------------------------------------------------------
# CENTRO INTELIGENTE DE MONITOREO — variables de entorno de la API
# Nunca versione el archivo .env real.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Cadena de conexión PostgreSQL (usuario con permisos sobre la base)
DATABASE_URL="postgresql://cim:CAMBIAR@localhost:5432/cim"
# Secreto de firma de sesiones (mínimo 32 caracteres, aleatorio). Ej: openssl rand -hex 32
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"
# Duración de la sesión (horas). Se recomienda igual a la duración del turno.
JWT_EXPIRES_HOURS=12
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGIN="http://localhost:5173"
# true detrás de HTTPS (cookie Secure)
COOKIE_SECURE=false
# Carpeta privada para documentos y fotografías (fuera del webroot, con respaldo)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
# Motor de reglas: true para ejecutarlo dentro de la API; en producción se recomienda el proceso worker dedicado
RUN_SCHEDULER=true
SCHEDULER_TICK_SECONDS=60
BCRYPT_ROUNDS=12
LOG_LEVEL=info
# Solo para la semilla inicial
SEED_PASSWORD="CambiarEnPrimerInicio2026!"
# SEED_DEMO=true carga datos de demostración etiquetados [DEMO]
